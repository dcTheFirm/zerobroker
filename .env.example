# === Required environment variables for running ZeroBroker locally ===
# Copy this file to .env (repo root) and edit values. DO NOT commit secrets.

# MongoDB
# - Use a local MongoDB running on port 5001 (example):
MONGODB_URI=mongodb://localhost:5001/zero_broker
# - Or use MongoDB Atlas (uncomment and fill):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/zero_broker?retryWrites=true&w=majority
MONGODB_DB_NAME=zero_broker

# Host binding for backend services (default binds to all interfaces)
HOST=0.0.0.0

# Optional explicit ports for services (defaults are used if omitted)
# When provided, the services will read PORT (or service-specific PORT env if set in their startup)
AUTH_PORT=5000
HOME_PORT=4001
RENT_PORT=4002
BUY_PORT=4003
SEARCH_PORT=4004
FRONTEND_PORT=5173

# Frontend (Vite) — the frontend requires these VITE_* variables at build/dev time
# These must point to the running backend service endpoints. Set these in front-end/.env
VITE_AUTH_BASE_URL=http://localhost:5000
VITE_HOME_BASE_URL=http://localhost:4001
VITE_RENT_BASE_URL=http://localhost:4002
VITE_BUY_BASE_URL=http://localhost:4003
VITE_SEARCH_BASE_URL=http://localhost:4004

# Notes:
# - The backend services require MONGODB_URI (or MONGO_URI). The app will error if not present.
# - For local development with Mongo on port 5001 use the example above.
# - For the frontend dev server, create front-end/.env (or set these VITE_ vars in your environment)
#   and restart the dev server so Vite picks up the values.
# - Do not add credentials or sensitive values to version control. Keep a private .env for secrets.
# === End of file ===
