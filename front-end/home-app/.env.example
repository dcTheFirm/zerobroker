# Example .env for home micro-frontend (copy to .env and edit)
# The home app uses the Home backend to fetch featured listings, cities, etc.
VITE_HOME_BASE_URL=http://localhost:4001

# If you also need auth or other services while developing this app, set:
# VITE_AUTH_BASE_URL=http://localhost:5000
# VITE_SEARCH_BASE_URL=http://localhost:4004

# Notes:
# - Replace localhost:4001 with your deployed backend URL when deploying to prod.
# - Restart Vite after editing .env.
