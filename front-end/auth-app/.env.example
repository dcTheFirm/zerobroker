# Example .env for auth micro-frontend (copy to .env and edit)
# The auth app and its UI call the Auth backend for signup/signin.
VITE_AUTH_BASE_URL=http://localhost:5000

# Optional dev variables:
# VITE_HOME_BASE_URL=http://localhost:4001
# VITE_RENT_BASE_URL=http://localhost:4002

# Notes:
# - For production, set this to the auth service URL (e.g., https://auth.example.com).
# - Restart Vite/dev server after editing .env.
